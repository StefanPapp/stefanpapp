---
interface Props {
  formspreeId: string;
}
const { formspreeId } = Astro.props;
---

<div class="contact-form-wrapper">
  <!-- Error banner -->
  <div
    id="form-error-banner"
    class="hidden bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 mb-6 font-sans text-sm"
    role="alert"
    aria-live="assertive"
  >
    Something went wrong. Please try again or email me directly.
  </div>

  <!-- Success message -->
  <div
    id="form-success"
    class="hidden bg-green-50 border border-green-200 text-green-800 rounded-lg px-6 py-8 text-center"
    role="status"
    aria-live="polite"
  >
    <p class="font-sans font-semibold text-lg mb-2">Message sent.</p>
    <p class="font-sans text-sm">I will get back to you within a few business days.</p>
  </div>

  <form
    id="contact-form"
    action={`https://formspree.io/f/${formspreeId}`}
    method="POST"
    novalidate
    class="space-y-6"
  >
    <!-- Honeypot -->
    <input
      type="text"
      name="_gotcha"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
    />

    <!-- Name -->
    <div>
      <label for="field-name" class="block font-sans text-sm font-semibold text-navy mb-1">
        Name <span aria-hidden="true" class="text-red-500">*</span>
      </label>
      <input
        id="field-name"
        type="text"
        name="name"
        required
        minlength="2"
        autocomplete="name"
        class="w-full border border-cream-dark rounded px-3 py-2 font-sans text-sm text-navy placeholder-slate/40 focus:outline-none focus:ring-2 focus:ring-amber focus:border-transparent"
        placeholder="Your full name"
      />
      <p
        id="error-name"
        class="form-error hidden mt-1 font-sans text-xs text-red-600"
        aria-live="polite"
      ></p>
    </div>

    <!-- Email -->
    <div>
      <label for="field-email" class="block font-sans text-sm font-semibold text-navy mb-1">
        Email <span aria-hidden="true" class="text-red-500">*</span>
      </label>
      <input
        id="field-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        class="w-full border border-cream-dark rounded px-3 py-2 font-sans text-sm text-navy placeholder-slate/40 focus:outline-none focus:ring-2 focus:ring-amber focus:border-transparent"
        placeholder="you@example.com"
      />
      <p
        id="error-email"
        class="form-error hidden mt-1 font-sans text-xs text-red-600"
        aria-live="polite"
      ></p>
    </div>

    <!-- Reason -->
    <div>
      <label for="field-reason" class="block font-sans text-sm font-semibold text-navy mb-1">
        Reason <span aria-hidden="true" class="text-red-500">*</span>
      </label>
      <select
        id="field-reason"
        name="reason"
        required
        class="w-full border border-cream-dark rounded px-3 py-2 font-sans text-sm text-navy bg-white focus:outline-none focus:ring-2 focus:ring-amber focus:border-transparent"
      >
        <option value="" disabled selected>Select a reason…</option>
        <option value="Consulting">Consulting</option>
        <option value="Speaking">Speaking</option>
        <option value="Investment">Investment</option>
        <option value="Other">Other</option>
      </select>
      <p
        id="error-reason"
        class="form-error hidden mt-1 font-sans text-xs text-red-600"
        aria-live="polite"
      ></p>
    </div>

    <!-- Message -->
    <div>
      <label for="field-message" class="block font-sans text-sm font-semibold text-navy mb-1">
        Message <span class="text-slate font-normal">(optional)</span>
      </label>
      <textarea
        id="field-message"
        name="message"
        rows="5"
        maxlength="2000"
        class="w-full border border-cream-dark rounded px-3 py-2 font-sans text-sm text-navy placeholder-slate/40 focus:outline-none focus:ring-2 focus:ring-amber focus:border-transparent resize-y"
        placeholder="Anything useful for context…"
      ></textarea>
      <p class="font-sans text-xs text-slate/60 mt-1 text-right">
        <span id="char-count">0</span>/2000
      </p>
    </div>

    <!-- Submit -->
    <button
      id="submit-btn"
      type="submit"
      class="w-full bg-amber text-navy font-sans font-semibold px-6 py-3 rounded hover:bg-amber-light transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
    >
      Send message
    </button>
  </form>
</div>

<script>
  (() => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successDiv = document.getElementById('form-success') as HTMLElement;
    const errorBanner = document.getElementById('form-error-banner') as HTMLElement;
    const charCount = document.getElementById('char-count') as HTMLElement;
    const messageField = document.getElementById('field-message') as HTMLTextAreaElement;

    // Character count
    messageField.addEventListener('input', () => {
      charCount.textContent = String(messageField.value.length);
    });

    // Validation helpers
    function showError(fieldId: string, message: string) {
      const el = document.getElementById(`error-${fieldId}`);
      if (!el) return;
      el.textContent = message;
      el.classList.remove('hidden');
      const input = document.getElementById(`field-${fieldId}`);
      input?.setAttribute('aria-invalid', 'true');
    }

    function clearError(fieldId: string) {
      const el = document.getElementById(`error-${fieldId}`);
      if (!el) return;
      el.textContent = '';
      el.classList.add('hidden');
      const input = document.getElementById(`field-${fieldId}`);
      input?.removeAttribute('aria-invalid');
    }

    function validateField(fieldId: string): boolean {
      const input = document.getElementById(`field-${fieldId}`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (!input) return true;

      if (fieldId === 'name') {
        if (!input.value.trim()) {
          showError('name', 'Name is required.');
          return false;
        }
        if (input.value.trim().length < 2) {
          showError('name', 'Name must be at least 2 characters.');
          return false;
        }
        clearError('name');
        return true;
      }

      if (fieldId === 'email') {
        if (!input.value.trim()) {
          showError('email', 'Email is required.');
          return false;
        }
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(input.value.trim())) {
          showError('email', 'Please enter a valid email address.');
          return false;
        }
        clearError('email');
        return true;
      }

      if (fieldId === 'reason') {
        if (!input.value) {
          showError('reason', 'Please select a reason.');
          return false;
        }
        clearError('reason');
        return true;
      }

      return true;
    }

    // Blur validation
    ['name', 'email', 'reason'].forEach((id) => {
      const el = document.getElementById(`field-${id}`);
      el?.addEventListener('blur', () => validateField(id));
    });

    // Submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameOk = validateField('name');
      const emailOk = validateField('email');
      const reasonOk = validateField('reason');

      if (!nameOk || !emailOk || !reasonOk) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      errorBanner.classList.add('hidden');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.classList.add('hidden');
          successDiv.classList.remove('hidden');
        } else {
          throw new Error(`HTTP ${res.status}`);
        }
      } catch {
        errorBanner.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    });
  })();
</script>
